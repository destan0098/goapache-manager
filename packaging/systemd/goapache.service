[Unit]
Description=GoApache Manager
Documentation=https://github.com/destan0098/goapache-manager

After=network.target goapache-helper.service
Requires=goapache-helper.service

[Service]
Type=simple

User=goapache
Group=goapache

WorkingDirectory=/opt/goapache

Environment=GOAPACHE_DB=/var/lib/goapache/goapache.db

ExecStart=/opt/goapache/goapache

Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true

ProtectSystem=strict
ProtectHome=true

ReadWritePaths=/var/lib/goapache
ReadWritePaths=/var/log/goapache

ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

UMask=0027

[Install]
WantedBy=multi-user.target
