[Unit]
Description=GoApache Privileged Helper
After=local-fs.target
Before=goapache.service

[Service]
Type=simple
User=root
Group=root

RuntimeDirectory=goapache
RuntimeDirectoryMode=0750

ExecStart=/opt/goapache/goapache-helper

Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true

ProtectSystem=strict
ProtectHome=true

ReadWritePaths=/etc/apache2/sites-available
ReadWritePaths=/etc/apache2/sites-enabled
ReadWritePaths=/var/www

ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

RestrictSUIDSGID=true
LockPersonality=true

UMask=0027

[Install]
WantedBy=multi-user.target
